#!/usr/bin/env bash
#
# Opt-in pre-commit hook: runs the structural guards before every commit.
#
# Enable (one-time, per clone):
#   git config core.hooksPath .githooks
#
# The guards take seconds and are the same checks CI runs on every PR
# (.github/workflows/guards.yml) — failing here just fails faster. CI remains
# authoritative: guards that need tools missing locally (ast-grep) report
# SKIPPED here and still run in CI.
#
# Bypass for a genuine emergency (CI will still catch it):
#   git commit --no-verify

set -u
ROOT="$(git rev-parse --show-toplevel)"

echo "pre-commit: running structural guards (bypass with --no-verify)…"
if ! "$ROOT/scripts/guards/run-guards.sh"; then
    echo ""
    echo "pre-commit: commit blocked — a structural guard failed."
    echo "See docs/guards/README.md for how to fix each guard."
    exit 1
fi
exit 0
